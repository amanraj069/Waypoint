# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The planner tries OpenAI first when OPENAI_API_KEY is set, then Gemini.
# Set either one, or both. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. HIGH (default): gpt-5-mini, then gpt-4o-mini, then gpt-5-nano.
# LOW: gpt-5-nano, then gpt-4.1-nano. Cheaper, and the plans are a little weaker.
# COST=HIGH

# Optional. How long gpt-5 models think: minimal, low (default), medium, high.
# It applies to every gpt-5 model.
# Thinking is billed as output, so more of it costs more and takes longer.
# OPENAI_REASONING_EFFORT=low

# Gemini: the fallback, or the only planner without an OpenAI key.
# https://aistudio.google.com/apikey
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# Optional. Moves one model to the front of a ladder; the remaining fallbacks
# still apply. OPENAI_MODELS / GEMINI_MODELS (comma separated) replace a ladder.
# OPENAI_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-3.8-flash
