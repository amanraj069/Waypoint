# Copy to .env and fill in. .env is gitignored and must never be committed.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# Optional. Moves one model to the front of the ladder; the remaining
# fallbacks still apply. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.8-flash
