new file mode 100644
index 0000000..2a67d83
--- /dev/null
+++ b/tests/test_key_pool.py
@@ -0,0 +1,298 @@
+"""The planner rotates across GEMINI_API_KEY1, GEMINI_API_KEY2, ... before giving up."""
+
+from __future__ import annotations
+
+import logging
+
+import pytest
+
+from conftest import VALID_PAYLOAD, http_error, json_response
+from planner import PlannerAPIError, plan
+from planner.config import API_KEY_VAR, MODEL_LADDER, get_api_key, get_api_keys
+from planner.key_pool import (
+    RATE_LIMIT_COOLDOWN_S,
+    Failure,
+    KeysExhaustedError,
+    classify,
+)
+from planner.llm_planner import make_key_pool
+
+FIRST, SECOND = MODEL_LADDER[:2]
+
+
+@pytest.fixture(autouse=True)
+def clean_env(monkeypatch):
+    """Neither a developer's .env keys nor model overrides may leak in."""
+    import os
+
+    for name in list(os.environ):
+        if name.startswith(API_KEY_VAR) or name in ("GEMINI_MODEL", "GEMINI_MODELS"):
+            monkeypatch.delenv(name)
+
+
+class Scripted:
+    """One fake client per key, each answering from its own script.
+
+    Every call is recorded as (key, model) in a log shared by the whole pool,
+    so a test can assert the exact order keys and models were tried in.
+    """
+
+    def __init__(self, **scripts):
+        self.scripts = {key: list(outcomes) for key, outcomes in scripts.items()}
+        self.calls: list[tuple[str, str]] = []
+
+    def factory(self, key: str):
+        scripted = self
+
+        class _Client:
+            class interactions:  # noqa: N801 - mirrors the SDK attribute
+                @staticmethod
+                def create(**kwargs):
+                    scripted.calls.append((key, kwargs["model"]))
+                    outcomes = scripted.scripts[key]
+                    if not outcomes:
+                        raise AssertionError(f"{key} ran out of scripted outcomes")
+                    outcome = outcomes.pop(0)
+                    if isinstance(outcome, BaseException):
+                        raise outcome
+                    return outcome
+
+        return _Client()
+
+
+class Clock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def __call__(self) -> float:
+        return self.now
+
+
+def install(monkeypatch, scripted: Scripted, keys=("k1", "k2", "k3"), clock=None):
+    pool = make_key_pool(list(keys), scripted.factory)
+    if clock is not None:
+        pool._clock = clock
+    monkeypatch.setattr("planner.llm_planner._pool", pool)
+    return pool
+
+
+def ok():
+    return json_response(VALID_PAYLOAD)
+
+
+# --- configuration -----------------------------------------------------------
+
+
+def test_numbered_keys_are_read_in_numeric_order(monkeypatch):
+    monkeypatch.setenv(f"{API_KEY_VAR}10", "ten")
+    monkeypatch.setenv(f"{API_KEY_VAR}2", "two")
+    monkeypatch.setenv(f"{API_KEY_VAR}1", "one")
+
+    assert get_api_keys() == ("one", "two", "ten")
+    assert get_api_key() == "one"
+
+
+def test_blank_keys_are_skipped_and_values_trimmed(monkeypatch):
+    monkeypatch.setenv(f"{API_KEY_VAR}1", "  ")
+    monkeypatch.setenv(f"{API_KEY_VAR}2", " two ")
+    monkeypatch.setenv(f"{API_KEY_VAR}3", "")
+
+    assert get_api_keys() == ("two",)
+
+
+def test_the_legacy_single_key_still_counts_after_the_numbered_ones(monkeypatch):
+    monkeypatch.setenv(API_KEY_VAR, "legacy")
+    monkeypatch.setenv(f"{API_KEY_VAR}1", "one")
+
+    assert get_api_keys() == ("one", "legacy")
+
+
+def test_a_key_listed_twice_is_one_key(monkeypatch):
+    monkeypatch.setenv(f"{API_KEY_VAR}1", "same")
+    monkeypatch.setenv(f"{API_KEY_VAR}2", "same")
+
+    assert get_api_keys() == ("same",)
+
+
+def test_no_keys_means_none(monkeypatch):
+    assert get_api_keys() == ()
+    assert get_api_key() is None
+
+
+def test_the_pool_is_built_from_the_environment(monkeypatch):
+    import planner.llm_planner as llm_planner
+
+    monkeypatch.setenv(f"{API_KEY_VAR}1", "one")
+    monkeypatch.setenv(f"{API_KEY_VAR}2", "two")
+    made: list[str] = []
+    monkeypatch.setattr(llm_planner.genai, "Client", lambda api_key: made.append(api_key))
+
+    pool = llm_planner.get_key_pool()
+
+    assert pool.size == 2
+    assert made == []  # clients are only made when a key is first used
+
+
+# --- classification ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("status", "kind"),
+    [
+        (429, Failure.RATE_LIMITED),
+        (401, Failure.KEY_REJECTED),
+        (403, Failure.KEY_REJECTED),
+        (404, Failure.MODEL_UNAVAILABLE),
+        (500, Failure.MODEL_UNAVAILABLE),
+        (503, Failure.MODEL_UNAVAILABLE),
+        (400, Failure.INVALID_REQUEST),
+    ],
+)
+def test_errors_are_classified_by_what_could_fix_them(status, kind):
+    assert classify(http_error(status)) is kind
+
+
+# --- rotation ----------------------------------------------------------------
+
+
+@pytest.mark.parametrize("status", [429, 401, 403])
+def test_a_key_specific_failure_rotates_to_the_next_key_on_the_same_model(
+    status, monkeypatch, constraints
+):
+    scripted = Scripted(k1=[http_error(status)], k2=[ok()], k3=[])
+    install(monkeypatch, scripted)
+
+    plan("survey the north field", constraints)
+
+    assert scripted.calls == [("k1", FIRST), ("k2", FIRST)]
+
+
+def test_an_overloaded_model_moves_to_the_next_model_without_rotating_keys(
+    monkeypatch, constraints
+):
+    """Every key shares the model's capacity, so rotating keys would not help."""
+    scripted = Scripted(k1=[http_error(503), ok()], k2=[], k3=[])
+    install(monkeypatch, scripted)
+
+    plan("survey the north field", constraints)
+
+    assert scripted.calls == [("k1", FIRST), ("k1", SECOND)]
+
+
+def test_every_key_out_of_quota_moves_to_the_next_model(monkeypatch, constraints):
+    scripted = Scripted(
+        k1=[http_error(429), ok()],
+        k2=[http_error(429)],
+        k3=[http_error(429)],
+    )
+    install(monkeypatch, scripted)
+
+    plan("survey the north field", constraints)
+
+    # All three are benched, so none is preferred and the order starts over.
+    assert scripted.calls == [("k1", FIRST), ("k2", FIRST), ("k3", FIRST), ("k1", SECOND)]
+
+
+def test_every_key_rejected_fails_fast_without_burning_the_ladder(monkeypatch, constraints):
+    """A pool of bad keys fails identically on every model."""
+    scripted = Scripted(k1=[http_error(401)], k2=[http_error(403)], k3=[http_error(401)])
+    install(monkeypatch, scripted)
+
+    with pytest.raises(PlannerAPIError) as exc_info:
+        plan("survey the north field", constraints)
+
+    assert [model for _, model in scripted.calls] == [FIRST] * 3
+    assert "every key failed" in str(exc_info.value)
+
+
+def test_a_bad_request_fails_fast_on_the_first_key(monkeypatch, constraints):
+    scripted = Scripted(k1=[http_error(400)], k2=[], k3=[])
+    install(monkeypatch, scripted)
+
+    with pytest.raises(PlannerAPIError):
+        plan("survey the north field", constraints)
+
+    assert scripted.calls == [("k1", FIRST)]
+
+
+def test_exhausting_every_model_and_key_lists_each_model(monkeypatch, constraints):
+    scripted = Scripted(k1=[http_error(503) for _ in MODEL_LADDER])
+    install(monkeypatch, scripted, keys=("k1",))
+
+    with pytest.raises(PlannerAPIError) as exc_info:
+        plan("survey the north field", constraints)
+
+    for model in MODEL_LADDER:
+        assert model in str(exc_info.value)
+
+
+# --- stickiness and cooldown -------------------------------------------------
+
+
+def test_the_pool_sticks_with_the_key_that_last_worked(monkeypatch, constraints):
+    scripted = Scripted(k1=[http_error(429)], k2=[ok(), ok()], k3=[])
+    install(monkeypatch, scripted)
+
+    plan("first mission", constraints)
+    plan("second mission", constraints)
+
+    assert [key for key, _ in scripted.calls] == ["k1", "k2", "k2"]
+
+
+def test_a_benched_key_goes_to_the_back_until_its_cooldown_ends(monkeypatch, constraints):
+    clock = Clock()
+    scripted = Scripted(k1=[http_error(429), ok()], k2=[ok(), http_error(429)], k3=[])
+    install(monkeypatch, scripted, keys=("k1", "k2"), clock=clock)
+
+    plan("first", constraints)  # k1 benched, k2 answers and becomes sticky
+    clock.now += RATE_LIMIT_COOLDOWN_S + 1
+    plan("second", constraints)  # k2 now rate limited; k1 has cooled down
+
+    assert [key for key, _ in scripted.calls] == ["k1", "k2", "k2", "k1"]
+
+
+def test_a_cooling_key_is_still_tried_last_rather_than_skipped(monkeypatch, constraints):
+    clock = Clock()
+    scripted = Scripted(k1=[http_error(429), ok()], k2=[http_error(429)])
+    install(monkeypatch, scripted, keys=("k1", "k2"), clock=clock)
+
+    # A one-model ladder, so benching both keys ends the first mission.
+    monkeypatch.setenv("GEMINI_MODELS", FIRST)
+    with pytest.raises(PlannerAPIError):
+        plan("first", constraints)
+
+    monkeypatch.delenv("GEMINI_MODELS")
+    plan("second", constraints)  # nothing is ready, but k1 still gets a try
+
+    assert scripted.calls[-1] == ("k1", FIRST)
+
+
+def test_retry_after_sets_the_cooldown(monkeypatch):
+    from google.genai._gaos.lib import compat_errors
+
+    response = compat_errors.httpx.Response(
+        429,
+        headers={"retry-after": "5"},
+        request=compat_errors.httpx.Request("POST", "https://example.invalid"),
+    )
+    error = compat_errors.RateLimitError("slow down", response=response, body=None)
+    clock = Clock()
+    scripted = Scripted(k1=[error])
+    pool = make_key_pool(["k1"], scripted.factory)
+    pool._clock = clock
+
+    with pytest.raises(KeysExhaustedError):
+        pool.run(lambda client: client.interactions.create(model=FIRST))
+
+    assert pool._keys[0].cooling_until == clock.now + 5
+
+
+def test_logs_name_keys_by_position_never_by_secret(monkeypatch, constraints, caplog):
+    scripted = Scripted(**{"AIza-secret-one": [http_error(429)], "AIza-secret-two": [ok()]})
+    install(monkeypatch, scripted, keys=("AIza-secret-one", "AIza-secret-two"))
+
+    with caplog.at_level(logging.WARNING):
+        plan("survey the north field", constraints)
+
+    assert "key #1" in caplog.text
+    assert "AIza" not in caplog.text
