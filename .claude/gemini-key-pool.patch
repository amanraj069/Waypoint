diff --git a/planner/key_pool.py b/planner/key_pool.py
new file mode 100644
index 0000000..e5d911e
--- /dev/null
+++ b/planner/key_pool.py
@@ -0,0 +1,155 @@
+"""Failover across several Gemini API keys.
+
+Each key has its own quota, so a key that is rate limited or rejected is
+benched and the next one takes the call. What a different key cannot fix -- an
+overloaded model, a malformed request -- is rethrown for the caller to decide.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from dataclasses import dataclass
+from enum import Enum
+from typing import Any, Callable, Sequence, TypeVar
+
+log = logging.getLogger(__name__)
+
+T = TypeVar("T")
+
+RATE_LIMIT_COOLDOWN_S = 60.0
+REJECTED_KEY_COOLDOWN_S = 60.0 * 60.0
+
+
+class Failure(str, Enum):
+    """Why a call failed, which decides what is worth trying next."""
+
+    RATE_LIMITED = "rate-limited"  # this key's quota; another key may work
+    KEY_REJECTED = "key-rejected"  # this key is bad; another key may work
+    MODEL_UNAVAILABLE = "model-unavailable"  # overloaded or missing; try another model
+    INVALID_REQUEST = "invalid-request"  # our fault; nothing will fix it
+
+
+_TRANSPORT_ERRORS = {"APIConnectionError", "APITimeoutError", "NoResponseError"}
+
+
+def classify(exc: BaseException) -> Failure:
+    """Sort an SDK error by what could plausibly fix it."""
+    status = getattr(exc, "status_code", None)
+    if status is None:
+        # Connection and timeout errors carry no status; another model is on
+        # different capacity, so it is worth a try.
+        if type(exc).__name__ in _TRANSPORT_ERRORS:
+            return Failure.MODEL_UNAVAILABLE
+        return Failure.INVALID_REQUEST
+    if status == 429:
+        return Failure.RATE_LIMITED
+    if status in (401, 403):
+        return Failure.KEY_REJECTED
+    if status in (404, 408) or status >= 500:
+        return Failure.MODEL_UNAVAILABLE
+    return Failure.INVALID_REQUEST
+
+
+def _retry_after_s(exc: BaseException) -> float | None:
+    headers = getattr(getattr(exc, "response", None), "headers", None)
+    try:
+        value = headers.get("retry-after") if headers is not None else None
+        return float(value) if value else None
+    except (TypeError, ValueError):
+        return None
+
+
+class KeysExhaustedError(Exception):
+    """Every key in the pool failed for a reason another key might have fixed."""
+
+    def __init__(self, failures: list[tuple[str, Failure, BaseException]]):
+        self.failures = failures
+        super().__init__(
+            "; ".join(f"{label}: {kind.value}: {exc}" for label, kind, exc in failures)
+        )
+
+    @property
+    def all_rejected(self) -> bool:
+        """No key was accepted, so no other model will work either."""
+        return all(kind is Failure.KEY_REJECTED for _, kind, _ in self.failures)
+
+
+@dataclass
+class _PooledKey:
+    label: str  # 1-based position, used in logs so the secret never is
+    secret: str
+    cooling_until: float = 0.0
+    client: Any = None
+
+
+class KeyPool:
+    """Round-robin failover across API keys, sticky to the last healthy one.
+
+    Whichever key last succeeded is tried first on the next call, so a healthy
+    key keeps serving and a failing one is only revisited once the others run
+    into trouble. A benched key goes to the back of the order rather than being
+    skipped, so a pool where every key is cooling still makes one last attempt.
+    """
+
+    def __init__(
+        self,
+        secrets: Sequence[str],
+        client_factory: Callable[[str], Any],
+        *,
+        api_errors: tuple[type[BaseException], ...],
+        clock: Callable[[], float] = time.monotonic,
+    ):
+        self._keys = [_PooledKey(f"key #{i + 1}", s) for i, s in enumerate(secrets)]
+        self._client_factory = client_factory
+        self._api_errors = api_errors
+        self._clock = clock
+        self._active = 0
+
+    @property
+    def size(self) -> int:
+        return len(self._keys)
+
+    def run(self, attempt: Callable[[Any], T]) -> T:
+        """Call `attempt(client)` with each key in turn until one succeeds.
+
+        Raises KeysExhaustedError if every key was rate limited or rejected;
+        any other failure is rethrown immediately.
+        """
+        failures: list[tuple[str, Failure, BaseException]] = []
+        for index in self._attempt_order():
+            key = self._keys[index]
+            try:
+                result = attempt(self._client_for(key))
+            except self._api_errors as exc:
+                kind = classify(exc)
+                if kind not in (Failure.RATE_LIMITED, Failure.KEY_REJECTED):
+                    raise
+                self._bench(key, kind, exc)
+                failures.append((key.label, kind, exc))
+                log.warning("%s failed (%s), rotating", key.label, kind.value)
+                continue
+            key.cooling_until = 0.0
+            self._active = index
+            return result
+        raise KeysExhaustedError(failures)
+
+    def _client_for(self, key: _PooledKey) -> Any:
+        if key.client is None:
+            key.client = self._client_factory(key.secret)
+        return key.client
+
+    def _attempt_order(self) -> list[int]:
+        count = len(self._keys)
+        rotated = [(self._active + offset) % count for offset in range(count)]
+        now = self._clock()
+        ready = [i for i in rotated if self._keys[i].cooling_until <= now]
+        cooling = [i for i in rotated if self._keys[i].cooling_until > now]
+        return ready + cooling
+
+    def _bench(self, key: _PooledKey, kind: Failure, exc: BaseException) -> None:
+        if kind is Failure.KEY_REJECTED:
+            cooldown = REJECTED_KEY_COOLDOWN_S
+        else:
+            cooldown = _retry_after_s(exc) or RATE_LIMIT_COOLDOWN_S
+        key.cooling_until = self._clock() + cooldown
